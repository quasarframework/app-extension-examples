    "cycle": "pnpm --filter playground cycle",
    "postinstall": "pnpm --filter playground prepare"
  },
  "devDependencies": {
    "oxfmt": "^0.x",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "npm:@typescript/typescript6@^6.0.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "pnpm": ">= 11"
  },
  "productName": "Quasar App Extension"
